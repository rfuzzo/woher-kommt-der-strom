strom-api.rfuzzo.de {
	encode zstd gzip

	@exports path /apg/latest.json /apg/nowcast.json /apg/nowcast-history.json
	handle @exports {
		uri strip_prefix /apg
		root * /var/lib/apg-cache
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=60"
		file_server
	}

	respond / "woher-kommt-der-strom APG cache\n" 200
	respond 404
}
